# ==================================================
# .htaccess
# Compression + caching for static site
# ==================================================

# ----------------------------------------
# Compression for text-based assets
# ----------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------
# Browser caching
# ----------------------------------------
#
# Stated once, as Cache-Control. The earlier version said the same thing twice,
# through mod_expires and mod_headers, which made it look like the caching rules
# were a matter of which module a host happens to load. They were not: none of it
# ever reached the server, because the artifact upload dropped this file for
# being hidden. Saying it once leaves one place to read and one to be wrong in.
#
# The values below assume that stylesheets and scripts are addressed by a URL
# carrying their content version, which scripts/theme-version.rb produces and
# checks. Without that assumption a long max-age here is the bug it is meant to
# prevent, so the two belong together.
<IfModule mod_headers.c>
  # Pages revalidate every time. This is what makes a deploy arrive: the ETag
  # turns the usual case into a 304 with no body, and the reader can never hold
  # a page whose stylesheet has moved on without it.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, no-cache"
  </FilesMatch>

  # `immutable` is the promise that what lives at a URL never changes, and only
  # a versioned URL can keep it. Tied to the query rather than to the file name,
  # because the file is the same either way and the URL is not: the architecture
  # output links this very stylesheet without a version, and for a while it was
  # served frozen for a year with no revalidation to correct it.
  #
  # Without a version, an hour. Long enough to be worth caching, short enough
  # that a mistake corrects itself rather than outliving the deploy that made it.
  SetEnvIf Query_String "(^|&)v=" versioned_asset

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=versioned_asset
    Header set Cache-Control "public, max-age=3600" env=!versioned_asset
  </FilesMatch>

  # Fonts carry the version they were vendored at in their file name, which
  # makes their URLs content-addressed the same way.
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images are addressed by a plain name, so they are cached for a while rather
  # than forever: a replaced image has to be able to arrive.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # The manifest is unversioned and names the icons a device keeps, so it is
  # kept short enough to correct within a day.
  <FilesMatch "\.webmanifest$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
